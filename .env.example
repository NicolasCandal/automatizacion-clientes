# Copiar a .env e introducir únicamente valores propios del entorno.
# Solo se reconocen variables AC_; consultar docs/migracion.md al actualizar.
# Nunca copiar credenciales a este ejemplo.
AC_ENTORNO=desarrollo
AC_LOG_LEVEL=INFO
AC_ZONA_HORARIA=America/Argentina/Buenos_Aires

# Rutas relativas a AC_DIRECTORIO_BASE (por defecto, el directorio de ejecución).
# Cambiar DIRECTORIO_DATOS no modifica las rutas explícitas de los otros campos.
AC_DIRECTORIO_BASE=.
AC_DIRECTORIO_DATOS=datos
AC_DIRECTORIO_LOGS=logs
AC_CONTACTOS_PATH=datos/entrada/semana.json
AC_WHATSAPP_MANIFIESTO_PATH=datos/entrada/whatsapp/manifiesto.json
# Importación local: --importar-whatsapp --desde YYYY-MM-DD --hasta YYYY-MM-DD
# --manifiesto permite sustituir esta ruta; --aplicar guarda solo AC_CONTACTOS_PATH.
AC_EXCEL_PATH=datos/entrada/clientes.xlsx
AC_CATALOGO_PATH=datos/estado/catalogo.json
AC_ALIASES_PATH=datos/estado/aliases.json
AC_LISTA_NEGRA_PATH=datos/estado/lista_negra.json
AC_RESOLUCION_PATH=datos/salida/resolucion.json
AC_DIRECTORIO_RESPALDOS=datos/respaldos

AC_REPOSITORIO=excel
# Cambiar a sheets para usar Google mediante el mismo comando.
# Obligatorio únicamente con AC_REPOSITORIO=sheets.
# AC_SPREADSHEET_ID=
AC_CREDENTIALS_PATH=secretos/credentials.json
AC_TOKEN_PATH=secretos/token.json
AC_GOOGLE_TIPO_AUTENTICACION=oauth
# Para cuentas de servicio: AC_GOOGLE_TIPO_AUTENTICACION=cuenta_servicio
AC_GOOGLE_ALCANCES=["https://www.googleapis.com/auth/spreadsheets.readonly"]
# --aplicar con Sheets exige un alcance explícito de escritura:
# AC_GOOGLE_ALCANCES=["https://www.googleapis.com/auth/spreadsheets"]
# OAuth inicial: automatizacion-clientes --autorizar-google (sin opciones de registro).
# --simular no abre navegador ni guarda el token; puede renovarlo en memoria.
AC_GOOGLE_TIMEOUT_AUTORIZACION_SEGUNDOS=180

# Cantidad total de intentos, incluido el primero.
AC_REINTENTOS_MAXIMOS=4
AC_REINTENTO_ESPERA_MINIMA_SEGUNDOS=1
AC_REINTENTO_ESPERA_MAXIMA_SEGUNDOS=30
AC_TIMEOUT_RED_SEGUNDOS=30

# Política aplicada por el comando automatizacion-clientes.
AC_UMBRAL_COINCIDENCIA_AUTOMATICO=92
AC_UMBRAL_COINCIDENCIA_REVISION=80
AC_LIMITE_SUGERENCIAS_COINCIDENCIA=3
AC_SIMULACION=true
# --simular y --aplicar prevalecen sobre AC_SIMULACION.
