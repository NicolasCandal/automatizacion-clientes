# Copy to .env and provide values for your own environment.
# Configuration variables use the CA_ prefix.
# Never put real credentials in this example.
CA_ENVIRONMENT=development
CA_LOG_LEVEL=INFO
CA_TIME_ZONE=America/Argentina/Buenos_Aires

# Paths are relative to CA_BASE_DIRECTORY, which defaults to the working directory.
# Changing CA_DATA_DIRECTORY does not rewrite the other explicit paths.
CA_BASE_DIRECTORY=.
CA_DATA_DIRECTORY=data
CA_LOG_DIRECTORY=logs
CA_CONTACTS_PATH=data/input/week.json
CA_WHATSAPP_MANIFEST_PATH=data/input/whatsapp/manifest.json
CA_EXCEL_PATH=data/input/clients.xlsx
CA_CATALOG_PATH=data/state/catalog.json
CA_ALIASES_PATH=data/state/aliases.json
CA_EXCLUSION_LIST_PATH=data/state/exclusion_list.json
CA_RESOLUTION_PATH=data/output/resolution.json
CA_BACKUP_DIRECTORY=data/backups

CA_REPOSITORY=excel
# Set to sheets to use Google with the same registration command.
# Required only when CA_REPOSITORY=sheets:
# CA_SPREADSHEET_ID=
CA_CREDENTIALS_PATH=secrets/credentials.json
CA_TOKEN_PATH=secrets/token.json
CA_GOOGLE_AUTHENTICATION_TYPE=oauth
# Service accounts: CA_GOOGLE_AUTHENTICATION_TYPE=service_account
CA_GOOGLE_SCOPES=["https://www.googleapis.com/auth/spreadsheets.readonly"]
# Applying changes to Sheets requires explicit write scope and document permission:
# CA_GOOGLE_SCOPES=["https://www.googleapis.com/auth/spreadsheets"]
# Initial OAuth consent: client-automation --authorize-google
# Dry runs never open a browser or save a token; refresh may occur in memory.
CA_GOOGLE_AUTHORIZATION_TIMEOUT_SECONDS=180

# Total attempts, including the first request.
CA_MAX_ATTEMPTS=4
CA_RETRY_MIN_WAIT_SECONDS=1
CA_RETRY_MAX_WAIT_SECONDS=30
CA_NETWORK_TIMEOUT_SECONDS=30

# Matching policy and default execution mode.
CA_AUTOMATIC_MATCH_THRESHOLD=92
CA_REVIEW_MATCH_THRESHOLD=80
CA_MATCH_SUGGESTION_LIMIT=3
CA_DRY_RUN=true
# --dry-run and --apply override CA_DRY_RUN.
